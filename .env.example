# PostgreSQL
POSTGRES_USER=data_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_FIRSTNAME=First_name
AIRFLOW_ADMIN_LASTNAME=Last_name
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Spark Resources

# Spark Standalone Worker
SPARK_WORKER_CORES=6
SPARK_WORKER_MEMORY=6G

# Maximum resources allocated to each streaming application
SPARK_STREAM_MAX_CORES=1
SPARK_STREAM_EXECUTOR_CORES=1

# pgAdmin credentials
PGADMIN_DEFAULT_EMAIL=pgadmin@gmail.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Snowflake service account
SNOWFLAKE_ACCOUNT=ORG_NAME-ACCOUNT_NAME
SNOWFLAKE_USER=ECOMMERCE_PIPELINE_USER
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake/rsa_key.p8

# Snowflake execution context
SNOWFLAKE_ROLE=ECOMMERCE_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=ECOMMERCE_WH
